# Copy to .env (never commit .env).
# On Netlify, add the same names under Site configuration > Environment variables.

# Web app URL from Google Apps Script (Deploy > Manage deployments). Must end in /exec
REACT_APP_LEAD_URL=

# Optional: links of your published sheet tabs (CSV). Leave empty to use the values in the code.
REACT_APP_PRICES_URL=
REACT_APP_SETTINGS_URL=
REACT_APP_MONTHLY_URL=
